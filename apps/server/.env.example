# Copy to .env locally. Never commit credentials. Google setup: Docs/GOOGLE_AUTH_SETUP.md
ENVIRONMENT=production
# URL-encode the password. Use Supabase's Session pooler, port 5432.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt&connect_timeout=10
# The example certificate path is relative to apps/server. Use an absolute path when starting elsewhere.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required only for private Storage; never set in the web app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=transient-print-jobs
CORS_ORIGINS=[]
SEED_DEMO_SHOPS=false
ALLOW_LOCAL_STORAGE=false
PAYMENT_PROVIDER=disabled
ALLOW_MOCK_PAYMENTS=false
ENABLE_API_DOCS=false
BOOTSTRAP_SHOP_ID=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# CAPTCHA provider: turnstile, recaptcha, or mock
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
# Secret for authenticating scheduled outbox / background cleanup tasks
SCHEDULER_SECRET=
