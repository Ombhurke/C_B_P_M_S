SHOP_ID=shop-demo-1
CLOUD_API_URL=http://localhost:8000/api/v1
CLOUD_WS_URL=ws://localhost:8000/ws/queue
# Leave empty to enter credentials at launch. Use a shop operator account.
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
# Set to an installed printer name for CLI operation; the GUI offers selection.
SELECTED_PRINTER_NAME=HP LaserJet Pro M404dn (B&W High Speed)
# Durable callback retry state; do not put this inside the temporary spool folder.
# LOCAL_STATE_DIR=%LOCALAPPDATA%\CBPMS\state
# Explicit demonstration switch. TRUE produces no physical output.
MOCK_PRINTING=false
# Enable only after confirming the physical printer accepts PDF directly.
# RAW is limited to single-copy, single-sided, 1-up default output.
RAW_PDF_SUPPORTED=false
